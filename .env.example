# ==============================================================================
# Environment Configuration Template
# Copy this file to .env and provide your actual MongoDB Atlas connection string
# ==============================================================================

# MongoDB Atlas connection string (Required for production and seed scripts)
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/research_papers?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/research_papers?retryWrites=true&w=majority

# Local backend port (Default: 5000)
PORT=5000

# Environment mode (development / production)
NODE_ENV=development

# Frontend URL for production CORS configuration
FRONTEND_URL=http://localhost:5173

# Optional: Set this in client/.env.production if deploying frontend and backend to separate domains
# VITE_API_BASE_URL=https://your-backend-api.vercel.app/api
